rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /tables/{tableToken} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /app_settings/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isStaff() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        adminDoc().role in ["admin", "manager", "manger"];
    }

    function isAdmin() {
      return isStaff() && adminDoc().role == "admin";
    }

    match /menu/{item} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menu_v2/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sales/{saleId} {
      allow read, write: if isAdmin();
    }

    match /daily_sales/{docId} {
      allow read, write: if isAdmin();
    }

    match /summaries/{docId} {
      allow read, write: if isAdmin();
    }

    match /sales_summary/{document=**} {
      allow read, write: if isAdmin();
    }

    match /orders/{orderId} {
      // Customer order creation is handled by the callable function using Admin SDK.
      allow create: if false;

      allow read: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
